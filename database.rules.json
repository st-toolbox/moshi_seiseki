{
  "rules": {
    ".read": false,
    ".write": false,
    "teachers": {
      ".read": "root.child('teachers').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "root.child('teachers').child(auth.uid).exists()"
      }
    },
    "pending_teachers": {
      ".read": "root.child('teachers').child(auth.uid).exists()",
      ".write": "root.child('teachers').child(auth.uid).exists()"
    },
    "exams": {
      ".read": "auth != null && ((auth.token.email_verified == true && auth.token.email.matches(/.*@(oky\\.)?asahi\\.ac\\.jp$/)) || root.child('teachers').child(auth.uid).exists())",
      ".write": "auth != null && root.child('teachers').child(auth.uid).exists()"
    },
    "students": {
      ".read": "root.child('teachers').child(auth.uid).exists()",
      ".write": "root.child('teachers').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('teachers').child(auth.uid).exists())",
        ".write": "root.child('teachers').child(auth.uid).exists() || (auth.uid === $uid && !data.exists())"
      }
    },
    "responses": {
      ".read": "root.child('teachers').child(auth.uid).exists()",
      "$examId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && (auth.uid === $uid || root.child('teachers').child(auth.uid).exists())"
        }
      }
    },
    "ref": {
      ".read": "auth != null && ((auth.token.email_verified == true && auth.token.email.matches(/.*@(oky\\.)?asahi\\.ac\\.jp$/)) || root.child('teachers').child(auth.uid).exists())",
      ".write": "auth != null && root.child('teachers').child(auth.uid).exists()"
    }
  }
}

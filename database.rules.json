{
  "rules": {
    ".read": false,
    ".write": false,

    "teachers": {
      ".read": "root.child('teachers').child(auth.uid).exists()",
      ".write": "root.child('teachers').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "root.child('teachers').child(auth.uid).exists() || (auth.uid === $uid && newData.val() === auth.token.email)"
      }
    },

    "pending_teachers": {
      ".read": "root.child('teachers').child(auth.uid).exists()",
      ".write": "root.child('teachers').child(auth.uid).exists()"
    },

    "exams": {
      ".read": "auth != null",
      ".write": "root.child('teachers').child(auth.uid).exists()"
    },

    "students": {
      ".read": "root.child('teachers').child(auth.uid).exists()",
      ".write": "root.child('teachers').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "root.child('teachers').child(auth.uid).exists() || (auth.uid === $uid && !data.exists())",
        "email": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        }
      }
    },

    "responses": {
      ".read": "root.child('teachers').child(auth.uid).exists()",
      "$examId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && (auth.uid === $uid || root.child('teachers').child(auth.uid).exists())",
          "score":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "status": { ".validate": "newData.isString() && (newData.val() === 'draft' || newData.val() === 'submitted')" },
          "email":  { ".validate": "newData.isString() && newData.val() === auth.token.email" }
        }
      }
    }
  }
}

{
  "rules": {
    ".read": false,
    ".write": false,
    "teachers": {
      ".read": "root.child('teachers').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "root.child('teachers').child(auth.uid).exists() || (auth != null && auth.token.email_verified == true && auth.uid === $uid && newData.val() === auth.token.email && root.child('pending_teachers').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '-at-')).val() === auth.token.email.toLowerCase())"
      }
    },
    "pending_teachers": {
      ".read": "root.child('teachers').child(auth.uid).exists()",
      ".write": "root.child('teachers').child(auth.uid).exists()",
      "$key": {
        ".read": "auth != null && auth.token.email_verified == true && data.val() === auth.token.email.toLowerCase()",
        ".write": "auth != null && auth.token.email_verified == true && data.val() === auth.token.email.toLowerCase() && !newData.exists()"
      }
    },
    "exams": {
      ".read": "auth != null && ((auth.token.email_verified == true && auth.token.email.matches(/^(OE|oe)[^@]*@(oky\\.)?asahi\\.ac\\.jp$/)) || root.child('teachers').child(auth.uid).exists())",
      ".write": "auth != null && root.child('teachers').child(auth.uid).exists()"
    },
    "secret": {
      ".read": "auth != null && root.child('teachers').child(auth.uid).exists()",
      ".write": "auth != null && root.child('teachers').child(auth.uid).exists()",
      "$examId": {
        "$part": {
          ".read": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/^(OE|oe)[^@]*@(oky\\.)?asahi\\.ac\\.jp$/) && ($part === 'AM' || $part === 'PM') && root.child('responses').child($examId).child(auth.uid).child($part).child('status').val() === 'submitted' && root.child('exams').child($examId).child('hidden').val() !== true"
        }
      }
    },
    "students": {
      ".read": "root.child('teachers').child(auth.uid).exists()",
      ".write": "root.child('teachers').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('teachers').child(auth.uid).exists())",
        ".write": "root.child('teachers').child(auth.uid).exists() || (auth != null && auth.uid === $uid && !data.exists() && auth.token.email_verified == true && auth.token.email.matches(/^(OE|oe)[^@]*@(oky\\.)?asahi\\.ac\\.jp$/) && newData.child('email').val() === auth.token.email && newData.child('name').isString() && auth.token.email.beginsWith(newData.child('name').val() + '@') && !newData.child('active').exists() && !newData.child('gakunen').exists() && !newData.child('nendo').exists())"
      }
    },
    "responses": {
      ".read": "root.child('teachers').child(auth.uid).exists()",
      "$examId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && root.child('teachers').child(auth.uid).exists()",
          "$part": {
            ".write": "auth != null && auth.uid === $uid && newData.exists() && auth.token.email_verified == true && auth.token.email.matches(/^(OE|oe)[^@]*@(oky\\.)?asahi\\.ac\\.jp$/) && ($part === 'AM' || $part === 'PM') && (!data.exists() || data.child('status').val() === 'draft') && (newData.child('status').val() === 'draft' || newData.child('status').val() === 'paper_pending') && !newData.child('score').exists() && !newData.child('scannedBy').exists() && !newData.child('approvedBy').exists() && newData.child('email').val() === auth.token.email",
            "resubmit": {
              ".write": "auth != null && auth.uid === $uid && newData.exists() && auth.token.email_verified == true && auth.token.email.matches(/^(OE|oe)[^@]*@(oky\\.)?asahi\\.ac\\.jp$/) && ($part === 'AM' || $part === 'PM') && data.parent().child('status').val() === 'submitted' && !data.exists() && newData.child('answers').hasChildren() && newData.child('at').isNumber() && newData.child('email').val() === auth.token.email"
            }
          }
        }
      }
    },
    "ref": {
      ".read": "auth != null && root.child('teachers').child(auth.uid).exists()",
      ".write": "auth != null && root.child('teachers').child(auth.uid).exists()",
      "sections": {
        ".read": "auth != null && ((auth.token.email_verified == true && auth.token.email.matches(/^(OE|oe)[^@]*@(oky\\.)?asahi\\.ac\\.jp$/)) || root.child('teachers').child(auth.uid).exists())"
      },
      "secstat": {
        ".read": "auth != null && ((auth.token.email_verified == true && auth.token.email.matches(/^(OE|oe)[^@]*@(oky\\.)?asahi\\.ac\\.jp$/)) || root.child('teachers').child(auth.uid).exists())"
      },
      "kq": {
        ".read": "auth != null && ((auth.token.email_verified == true && auth.token.email.matches(/^(OE|oe)[^@]*@(oky\\.)?asahi\\.ac\\.jp$/)) || root.child('teachers').child(auth.uid).exists())"
      },
      "meta": {
        ".read": "auth != null && ((auth.token.email_verified == true && auth.token.email.matches(/^(OE|oe)[^@]*@(oky\\.)?asahi\\.ac\\.jp$/)) || root.child('teachers').child(auth.uid).exists())"
      }
    },
    "ippo": {
      ".read": "auth != null && root.child('teachers').child(auth.uid).exists()",
      ".write": "auth != null && root.child('teachers').child(auth.uid).exists()",
      "index": {
        ".read": "auth != null && (root.child('ippo').child('members').child(auth.uid).exists() || root.child('teachers').child(auth.uid).exists())"
      },
      "content": {
        ".read": "auth != null && (root.child('ippo').child('members').child(auth.uid).exists() || root.child('teachers').child(auth.uid).exists())"
      },
      "kq": {
        ".read": "auth != null && (root.child('ippo').child('members').child(auth.uid).exists() || root.child('teachers').child(auth.uid).exists())"
      },
      "kx": {
        ".read": "auth != null && ((root.child('ippo').child('members').child(auth.uid).exists() && root.child('ippo').child('config').child('kxOpen').val() === true) || root.child('teachers').child(auth.uid).exists())"
      },
      "kimg": {
        ".read": "auth != null && (root.child('ippo').child('members').child(auth.uid).exists() || root.child('teachers').child(auth.uid).exists())"
      },
      "kqmeta": {
        ".read": "auth != null && (root.child('ippo').child('members').child(auth.uid).exists() || root.child('teachers').child(auth.uid).exists())"
      },
      "quiz": {
        ".read": "auth != null && (root.child('ippo').child('members').child(auth.uid).exists() || root.child('teachers').child(auth.uid).exists())"
      },
      "config": {
        ".read": "auth != null"
      },
      "members": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "apply": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && auth.token.email_verified == true && auth.token.email.matches(/^(OE|oe)[^@]*@(oky\\.)?asahi\\.ac\\.jp$/) && !root.child('ippo').child('members').child(auth.uid).exists() && (!newData.exists() || (newData.child('email').val() === auth.token.email && newData.child('at').val() === now))"
        }
      },
      "log": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$id": {
            ".write": "auth != null && auth.uid === $uid && root.child('ippo').child('members').child(auth.uid).exists() && !data.exists() && newData.child('at').val() === now",
            ".validate": "newData.child('ev').isString() && newData.child('ev').val().length <= 20"
          }
        }
      },
      "assign": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "consent": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$id": {
            ".write": "auth != null && auth.uid === $uid && auth.token.email_verified == true && auth.token.email.matches(/^(OE|oe)[^@]*@(oky\\.)?asahi\\.ac\\.jp$/) && !data.exists() && newData.child('at').val() === now && newData.child('email').val() === auth.token.email",
            ".validate": "newData.child('ai').isBoolean() && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 40 && newData.child('v').isString()"
          }
        }
      },
      "consentimg": {
        "$uid": {
          "$id": {
            ".write": "auth != null && auth.uid === $uid && auth.token.email_verified == true && auth.token.email.matches(/^(OE|oe)[^@]*@(oky\\.)?asahi\\.ac\\.jp$/) && !data.exists()",
            ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 500000"
          }
        }
      },
      "seen": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('ippo').child('members').child(auth.uid).exists() && newData.isNumber()"
        }
      }
    }
  }
}
